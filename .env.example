# ---- Liara ----
# توکن را از https://console.liara.ir/API بگیرید. اگر خالی باشد، برنامه در «حالت شبیه‌سازی» اجرا می‌شود.
LIARA_API_TOKEN=
LIARA_API_BASE=https://api.liara.ir
# اگر اپ‌ها در یک «تیم» هستند (در آدرس درخواست‌های پنل به‌صورت teamID=... دیده می‌شود):
LIARA_TEAM_ID=

# ---- LLM (اختیاری؛ هر سرویس سازگار با OpenAI) ----
# بدون کلید، دستیار با «مغز قواعد داخلی» کار می‌کند و همه‌ی سناریوها اجرا می‌شوند.
# مثال سرویس هوش مصنوعی لیارا:  LLM_BASE_URL=https://ai.liara.ir/api/v1/<your-id>
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=openai/gpt-4o-mini

# ---- GitHub (اختیاری: لینک مستقیم از stack trace به خط کد) ----
GITHUB_REPO=
GITHUB_BRANCH=main

# ---- امنیت ----
# normal: عملیات کم‌ریسک خودکار | strict: همه‌ی عملیات نوشتنی با تأیید
APPROVAL_MODE=normal
PORT=8000
